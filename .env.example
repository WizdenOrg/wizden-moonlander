# Server port (default 3030).
PORT=3030
# Interface to listen on. Default 127.0.0.1 (this machine only). The relay forwards
# requests to the endpoint the page supplies, so only expose it on a trusted network.
HOST=127.0.0.1

# API keys are entered in the page's top bar and stored in that browser only.
# The variables below are used only by the command-line tests and evaluation script.
# LAYA_URL=https://your-laya-endpoint
# LAYA_TOKEN=
# JEV_KEY=
