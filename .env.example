# ---- Local server
# Port (default 3030) and interface (default 127.0.0.1, this machine only).
PORT=3030
HOST=127.0.0.1
# Turn on the public-relay protections locally (always on when deployed on Vercel).
# RELAY_PUBLIC=1

# ---- Relay protections (public deployments)
# Extra page origins allowed to call the relay, besides the deployment's own host.
# RELAY_ALLOWED_ORIGINS=https://preview.example.com
# Decisions per minute per client IP, per function instance (0 = off). Default 300.
# RELAY_RATE_LIMIT=300
# Restrict Laya endpoints to these hosts (comma-separated, "*." wildcard).
# LAYA_ALLOWED_HOSTS=*.trycloudflare.com
# Model call timeout in ms, kept below the 30 s function limit. Default 25000.
# PROVIDER_TIMEOUT_MS=25000

# ---- Command-line tests and evaluation only
# API keys for the page are entered in its top bar and stay in that browser.
# LAYA_URL=https://your-laya-endpoint
# LAYA_TOKEN=
# JEV_KEY=
